# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — ignore ALL of them, including .env.example, so no keys can slip in
.env
.env.*
.env*.local

# typescript
*.tsbuildinfo

# the Remotion explainer (video/): dependencies, renders and generated assets —
# everything in public/ (marks copied from the site, draft voice, draft music)
# and src/generated/ is rebuilt by `npm run prepare:assets`
/video/node_modules/
/video/out/
/video/public/
/video/src/generated/

# graphify knowledge-graph output (regenerable, not source)
/graphify-out/

# editor / OS
.vscode/*
!.vscode/extensions.json

# local archive of dead code / old design handoffs / raw logo crops — not
# source; kept compressed on disk (see scripts/process-logos.py for how to
# get back at what's inside)
/.archive/
/archive-backup.tar.gz
