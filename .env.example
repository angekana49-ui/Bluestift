# ---- Supabase (project: Bluestift / mbvovxnfdptxvnhmdxew) ----
# Safe to expose to the browser (publishable / anon key):
NEXT_PUBLIC_SUPABASE_URL=https://mbvovxnfdptxvnhmdxew.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xZJVn7oMdcRg3aIOEvq_Dg_khVFzK-W

# SERVER ONLY — never expose to the client, never commit the real value.
# Get it from Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Kernel service (FastAPI) ----
# Local dev default; set to the deployed URL (Railway/Render) in production.
KERNEL_API_URL=http://localhost:8000
# Shared secret to authenticate backend -> kernel calls.
# NOTE: the kernel currently exposes NO auth — leave empty until it enforces one.
KERNEL_API_SECRET=

# ---- Cloudflare Turnstile (CAPTCHA) ----
# Public site key (safe to expose). Configure the matching SECRET in
# Supabase > Authentication > Attack Protection > CAPTCHA (provider: Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACuxAmn5zEzaFEON
# SERVER ONLY — same Turnstile secret, used by our own public endpoints
# (survey, contact, feedback, newsletter). If empty, verification is skipped.
TURNSTILE_SECRET_KEY=

# ---- RAYA tutor LLM (server-only). Gemini primary -> Groq fallback. ----
# Reuse the Kernel's keys. Keep cheap models (cost-sensitive).
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
# Voice discussions: OpenAI Whisper served by Groq (speech-to-text)
GROQ_WHISPER_MODEL=whisper-large-v3

# ---- Transactional email (server-only, Resend) ----
# App-level emails: teacher join-request decisions, and future invite/notification
# mail. Distinct from Supabase Auth's OWN confirmation/magic-link emails — those are
# sent by Supabase and need custom SMTP configured in the Supabase dashboard
# (Auth > SMTP) for production deliverability. If RESEND_API_KEY is empty the app
# runs unchanged and every send is a no-op (skipped).
RESEND_API_KEY=
# The verified From identity, e.g. "RAYA <no-reply@yourdomain.com>".
EMAIL_FROM=RAYA <no-reply@bluestift.local>
# Public base URL used to build absolute links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Billing / online checkout (server-only) ----
# Active online payment provider for self-serve checkout (card / mobile money /
# PayPal). Default `sandbox` = a simulated checkout with no external account, so
# the full pending->paid->activate loop works in dev/preview. Set to `cinetpay`
# (or your contracted aggregator) in production once the keys below are filled.
BILLING_PROVIDER=sandbox
# Escape hatch: the sandbox provider is refused in production (its webhook is
# public and would mint free subscriptions). Set to `true` ONLY to demo online
# checkout in a production-like env without real keys.
ALLOW_SANDBOX_BILLING=
# CinetPay (francophone-Africa aggregator: card + mobile money). Get these from
# the CinetPay dashboard. Base URL defaults to the production API when unset.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
# Secret key used to verify the HMAC on payment notifications (x-token header).
CINETPAY_SECRET=
# Once you've confirmed the HMAC field order against your CinetPay account, set to
# `true` to REJECT any notification whose signature fails (hard gate). Until then
# it's a soft gate — a mismatch is logged but the status is still re-checked
# server-to-server (the real security boundary), so real payments aren't lost.
CINETPAY_STRICT_WEBHOOK=

# ---- Google Classroom LMS (server-only OAuth) ----
# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type
# "Web application"). Enable the Google Classroom API and register the redirect
# URI <origin>/api/school/lms/google/callback. See docs/lms-google-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Abuse controls & anonymous-account lifecycle (server-only) ----
# Per-IP anti-burst on anonymous sign-up (/api/auth/anon): max NEW accounts per
# IP per rolling hour. A rolling window, NOT a lifetime cap — kept generous so a
# classroom behind one NAT'd IP isn't locked out. Raise it if a large cohort
# signs up together; captcha still gates every call. Default 20.
ANON_SIGNUP_MAX_PER_HOUR=20
# Secret shared with Vercel Cron. Set the SAME value in the Vercel project env;
# Vercel then sends `Authorization: Bearer <CRON_SECRET>` to the daily
# /api/cron/anon-lifecycle job. If empty, that route refuses every request.
CRON_SECRET=
# Anonymous-account reaping thresholds (days of inactivity). Only anonymous
# accounts with no real email AND not tied to a school are affected. Deactivated
# (banned + 'dormant') at DEACTIVATE, hard-deleted at DELETE. Returning users are
# reactivated on recovery. Defaults: 60 / 180.
ANON_DEACTIVATE_DAYS=60
ANON_DELETE_DAYS=180
